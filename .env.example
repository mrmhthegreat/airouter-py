# .env.example — copy this to .env and fill in your values.
#
#   cp .env.example .env
#   $EDITOR .env
#
# .env is in .gitignore — your keys never get committed.
#
# Load it before running airouter:
#
#   set -a; . ./.env; set +a     # bash, no extra deps
#   # or:
#   pip install python-dotenv && python -c "from dotenv import load_dotenv; load_dotenv()"
#
# Every variable below is OPTIONAL. Set only the keys for the providers you
# actually have. `airouter bootstrap` will skip providers whose env vars are
# empty (with a clear message) — so a partial setup still works.

# =============================================================================
# Provider API keys — set the ones you have free keys for.
# Get them from:
#   Groq:        https://console.groq.com/keys
#   Gemini:      https://aistudio.google.com/app/apikey
#   OpenRouter:  https://openrouter.ai/keys
#   Z.AI:        https://z.ai/manage-apikey/apikey-list
#   SambaNova:   https://cloud.sambanova.ai/apis
#   HuggingFace: https://huggingface.co/settings/tokens
#   Mistral:     https://console.mistral.ai/api-keys
#   OpenAI:      https://platform.openai.com/api-keys  (paid, not free-tier)
# =============================================================================

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZAI_API_KEY=
SAMBANOVA_API_KEY=
HF_TOKEN=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# Ollama (local — no key needed for the default install).
# Set OLLAMA_HOST only if your Ollama is on a different host/port.
# Set OLLAMA_API_KEY only if your Ollama is behind a proxy that requires auth.
# =============================================================================

# OLLAMA_HOST=http://localhost:11434
# OLLAMA_API_KEY=

# =============================================================================
# airouter configuration
# =============================================================================

# SQLite database file. Default: ./airouter.db
# Shared by the CLI, the HTTP server, and `import airouter` — they all see the
# same providers, usage, and pauses.
# AIROUTER_DB=airouter.db

# Master encryption secret for provider keys at rest.
#   * If set: provider keys are AES-256-GCM encrypted with this secret.
#   * If unset: airouter generates a random 32-byte hex key, writes it to
#     <db>.key (mode 0600), and uses that.
# IMPORTANT: back this up SEPARATELY from the DB. Lose it and the stored
# provider keys cannot be decrypted — you'd have to re-enter them.
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AIROUTER_SECRET=

# Admin token for the HTTP server. Enables admin endpoints
# (GET/POST /v1/providers, /v1/tenants, POST /v1/bootstrap, etc.).
# Empty = admin endpoints are disabled (use the CLI instead).
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIROUTER_ADMIN_TOKEN=

# CORS allow-list for the HTTP server (browser apps on other origins).
# Comma-separated origins or "*". Empty = CORS off.
# Example: AIROUTER_CORS=https://myapp.com,https://staging.myapp.com
# AIROUTER_CORS=

# Let tenants add providers with ANY base URL (SSRF risk — only enable if you
# trust all tenants). Default: off; tenants can only pick from the catalog.
# AIROUTER_ALLOW_TENANT_URLS=0

# =============================================================================
# `airouter me` subcommand (tenant self-service over HTTP)
# Set these on the CLIENT machine to talk to a running airouter server.
# =============================================================================

# AIROUTER_URL=http://localhost:8080
# AIROUTER_KEY=air_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
